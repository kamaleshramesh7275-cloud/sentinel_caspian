# ─────────────────────────────────────────────
# SENTINEL — Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
# Neon (recommended) or local PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-1.aws.neon.tech/sentinel?sslmode=require
# For local dev fallback, use:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sentinel

# ── LLM ───────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Caspian SDK ───────────────────────────────
# Run: caspian init   (mints key, writes to .env automatically)
CASPIAN_API_KEY=caspian_...
CASPIAN_BASE_URL=https://api.trycaspianai.com

# Caspian "username" (agent identity across channels)
CASPIAN_AGENT_USERNAME=sentinel-agent

# ── Slack ─────────────────────────────────────
# Slack Bot Token (xoxb-...) — for direct posting if Caspian not wired
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
# Default channel to post incidents to
SLACK_INCIDENT_CHANNEL=#incidents

# ── Telegram ──────────────────────────────────
TELEGRAM_BOT_TOKEN=...
# Chat ID (group or user) to send escalations to
TELEGRAM_CHAT_ID=...

# ── Email (Resend) ────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=sentinel@yourdomain.com
EMAIL_TO_ONCALL=oncall@yourdomain.com

# ── GitHub ────────────────────────────────────
GITHUB_TOKEN=ghp_...
# Repo where postmortems are committed (owner/repo)
GITHUB_POSTMORTEM_REPO=your-org/your-repo
GITHUB_POSTMORTEM_BRANCH=main

# ── Sentinel App ──────────────────────────────
# API key for webhook ingestion (set any secret string)
SENTINEL_API_KEY=sentinel-secret-key-change-me

# App base URL (used for reply webhook registration)
APP_BASE_URL=http://localhost:8000

# Escalation check interval (seconds, default 60)
ESCALATION_INTERVAL_SECONDS=60
